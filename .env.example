# CareConnect Environment Configuration
NODE_ENV=development
PORT=3000

# MongoDB Connection String
# Can be local: mongodb://localhost:27017/careconnect
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/careconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/careconnect

# JWT Authentication Secret
JWT_SECRET=careconnect_super_secret_jwt_key_2026_elderly_assistance

# Storage Directory for Secured Volunteer KYC Documents (kept outside public static web directory)
KYC_STORAGE_DIR=./storage/kyc_documents
